node_modules/
.DS_Store

# Keep the production GLB, but do not commit generation archives or local previews.
assets/lux3d/**/*.zip
assets/lux3d/**/preview.html
assets/scene-pack/source/**/*.zip
assets/scene-pack/source/**/rejected-attempt-*/
# Generated high-poly sources and intermediate LOD1 files stay local. The deployable
# LOD2 assets, prompts, manifests and review records remain versioned.
assets/scene-pack/source/ENV-*/
assets/scene-pack/source/PROP-*/
assets/scene-pack/runtime/lod1/ENV-*/
assets/scene-pack/runtime/lod1/PROP-*/
dist/assets/scene-pack/

# These two assets are required by scripts/build.mjs.
!assets/scene-pack/source/PROP-014/
assets/scene-pack/source/PROP-014/*
!assets/scene-pack/source/PROP-014/PROP-014.glb
!assets/scene-pack/runtime/lod1/PROP-011/
assets/scene-pack/runtime/lod1/PROP-011/*
!assets/scene-pack/runtime/lod1/PROP-011/PROP-011.glb

# Local credentials, caches and generated submission media are not source code.
.env
.env.*
!.env.example
tmp/
__pycache__/
submission/*
!submission/*.md
!submission/*.py
!submission/*.cjs
!submission/*.srt
